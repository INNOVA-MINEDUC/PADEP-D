# Lo que acaba dentro de una imagen Linux se versiona en LF pase lo que pase.
# En Windows, core.autocrlf convierte al hacer checkout y un CRLF colado en un
# .conf o en un entrypoint da errores que no se parecen en nada a su causa.
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
