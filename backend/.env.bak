# Copia este archivo a .env y ajusta los valores.

# ==== Servidor ====
PORT=4000
NODE_ENV=development

# ==== Base de datos (MySQL) ====
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=padep
DB_USER=root
DB_PASS=root
DB_DIALECT=mysql
DB_LOGGING=false
DB_SYNC=true
# none = arranque instantaneo (solo crea tablas faltantes). Usa 'npm run db:sync' al cambiar modelos.
DB_SYNC_MODE=none

# ==== JWT ====
JWT_SECRET=7a5bab187bd0ed95bd10e724cf21ca8d41f351e67463622f144059e9c1cc2ee34421561512636f69c48c6a01b311db83
JWT_EXPIRES_IN=8h

# ==== Auth ====
BCRYPT_ROUNDS=10
SEED_ADMIN_NOMBRE=Administrador PADEP
SEED_ADMIN_EMAIL=admin@mineduc.edu.gt
SEED_ADMIN_PASSWORD=Admin123*

# ==== API de extraccion (FastAPI) ====
# Este backend hace de puerta unica: el navegador solo habla con Express, y
# Express reenvia /api/extraccion/* a esta URL. Asi la API de extraccion sigue
# escuchando solo en 127.0.0.1 y no necesita CORS ni autenticacion propia.
EXTRACCION_URL=https://prueba.mineduc.edu.gt
# Solo si la API de extraccion vive tras un nginx con auth_basic.
EXTRACCION_BASIC_USER=padep
EXTRACCION_BASIC_PASS=admin2026
EXTRACCION_TIMEOUT_MS=30000

# ==== CORS ====
CORS_ORIGIN=*
