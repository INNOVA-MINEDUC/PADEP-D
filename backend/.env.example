# Copia este archivo a .env y ajusta los valores.

# ==== Servidor ====
PORT=4000
NODE_ENV=development

# ==== Base de datos (MySQL) ====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=padep
DB_USER=root
DB_PASS=root
DB_DIALECT=mysql
DB_LOGGING=false
DB_SYNC=true
# none = arranque instantaneo (solo crea tablas faltantes). Usa 'npm run db:sync' al cambiar modelos.
DB_SYNC_MODE=none

# ==== JWT ====
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# ==== Auth ====
BCRYPT_ROUNDS=10
SEED_ADMIN_NOMBRE=Administrador PADEP
SEED_ADMIN_EMAIL=admin@mineduc.edu.gt
SEED_ADMIN_PASSWORD=Admin123*

# ==== CORS ====
CORS_ORIGIN=*
