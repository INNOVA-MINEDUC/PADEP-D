# Plantilla del entorno de PRODUCCION.
#   cp backend/.env.production.example backend/.env.production
# y rellena lo marcado con <<< >>>. Este archivo va al repo; .env.production NO.

# ==== Servidor ====
PORT=4000
NODE_ENV=production

# ==== Base de datos (MySQL del servidor) ====
# Dos casos, segun donde viva MySQL en el servidor:
#   - MySQL nativo (apt/systemd)  -> DB_HOST=host.docker.internal
#   - MySQL en contenedor         -> DB_HOST=<nombre_del_contenedor>, y copia
#     deploy/docker-compose.override.yml.example a la raiz. Ver DEPLOY.md 2.
# En ambos casos el usuario necesita GRANT desde la red de Docker, no solo
# desde localhost. Ver DEPLOY.md 2.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=padep
DB_USER=<<< usuario_padep >>>
DB_PASS=<<< contrasena_del_usuario >>>
DB_DIALECT=mysql
DB_LOGGING=false

# La BD ya existe y el usuario de la app no tiene CREATE global: no intentes
# crearla en cada arranque.
DB_ENSURE=false

# El esquema se crea/actualiza a mano con `npm run db:sync`, nunca solo al
# arrancar: un sync automatico en produccion puede alterar tablas con datos.
DB_SYNC=false
DB_SYNC_MODE=none

# ==== JWT ====
# Genera uno nuevo, NO reutilices el de desarrollo:
#   openssl rand -base64 48
JWT_SECRET=<<< secreto_largo_y_aleatorio >>>
JWT_EXPIRES_IN=8h

# ==== Auth ====
BCRYPT_ROUNDS=12
SEED_ADMIN_NOMBRE=Administrador PADEP
SEED_ADMIN_EMAIL=admin@mineduc.edu.gt
# Solo se usa la primera vez que corre el seed. Cambiala tras el primer login.
SEED_ADMIN_PASSWORD=<<< contrasena_inicial_admin >>>

# ==== API de extraccion (FastAPI) ====
EXTRACCION_URL=https://prueba.mineduc.edu.gt
EXTRACCION_BASIC_USER=padep
EXTRACCION_BASIC_PASS=<<< pass_basic_del_nginx_de_extraccion >>>
EXTRACCION_TIMEOUT_MS=30000

# ==== CORS ====
# El navegador habla con un solo origen (nginx reparte /api), asi que no hace
# falta CORS. Se deja el dominio en vez de '*' para que un '*' olvidado no
# convierta la API en abierta.
CORS_ORIGIN=https://<<< dominio.mineduc.edu.gt >>>
