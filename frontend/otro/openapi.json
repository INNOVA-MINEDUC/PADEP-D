            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Qué hay de este corte en la base",
        "description": "Lo que MySQL sabe del corte: si está cargado, con qué etiquetas y cuánto.\n\nAparte de `GET /cortes/{id}`, que se deriva del disco a propósito y no\nconsulta la base. Si la base no responde —lo normal es que Docker no esté\nlevantado— devuelve `disponible: false` y el motivo, no un error: la\npantalla tiene que poder pintarse igual.",
        "operationId": "ver_carga_cortes__id_corte__carga_get",
        "parameters": [
