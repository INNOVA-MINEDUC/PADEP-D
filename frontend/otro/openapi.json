        }
      }
    },
    "/cortes/{id_corte}/altas": {
      "put": {
        "summary": "Guarda una casilla de una fila dada de alta a mano",
        "description": "Para quien está en la nómina y no tiene **ninguna** fila en el documento.\n\nLa llave es el carné, no el número de fila: una persona que el OCR nunca\nextrajo no tiene posición a la que apuntar. Solo se admiten los campos que\nel documento pide (`ALTA_CAMPOS`) y `ANULADA`, que deshace el alta sin\nborrar ninguna línea del CSV.\n\nLo escrito entra en la entrega al **rehacerla**, no al volcar: un alta se\ninyecta antes del cruce con la nómina, que es lo que le pone el nombre y el\nmunicipio y lo que la saca de la lista de sin registro.",
        "operationId": "dar_de_alta_cortes__id_corte__altas_put",
        "parameters": [
          {
            "name": "id_corte",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id Corte"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_dar_de_alta_cortes__id_corte__altas_put"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Dar De Alta Cortes  Id Corte  Altas Put"
                }
              }
            }
          },
          "422": {
